/*
 * audit —— 门禁留痕：本机的门禁判定，与堡垒机那边的审计是两回事。
 */
namespace go jmsexec

/**
 * 一条门禁留痕（jmsx_audit_query）。
 *
 * 留痕是**这台机器上**的门禁判定：调了哪个工具、参数是什么、门禁放行还是
 * 拦下、每一段的理由。
 *
 * 它跟堡垒机那边的审计是两回事，而且不能互相替代：被门禁拦下的命令
 * 根本没到堡垒机，所以堡垒机那边**什么都没有** —— 这条留痕是那件事
 * 唯一的证据。
 */
struct AuditEntry {
  /** 什么时候发生的（RFC3339）。 */
  1: required string ts,
  /** 哪个服务写的这一行。 */
  2: required string service,
  /** 调了哪个工具。 */
  3: required string tool,
  /**
   * 谁调的（MCP 客户端名）。
   *
   * 留痕答得出「试了什么、为什么被拦」，这一栏答「**哪个客户端**试的」——
   * 一台机器上跑着两个 agent 时，没有它就分不出是谁。
   *
   * ⚠️ 客户端**自报**的名字，不是认证过的身份：当线索用可以，当证据用不行。
   */
  4: optional string client,
  /**
   * 传了什么参数（已脱敏、已截断）。
   *
   * ⚠️ 它是**给人看的文本**，不保证是**可解析的 JSON**：脱敏会把凭据
   * 换成 `****`（**键名在兜底词表里**的那些），但形态规则可能吃掉
   * 闭引号或括号 ⇒ 结构未必还站得住。
   */
  5: optional string args,
  /** 门禁放行了吗。 */
  6: required bool allowed,
  /** 门禁每一段的判定与理由。 */
  7: optional list<AuditStage> stages,
  /** 花了多久（毫秒）。 */
  8: optional i64 duration_ms,
  /** 出了多少字节。 */
  9: optional i64 out_bytes,
  /** 出错时的原因。 */
  10: optional string error,
  /**
   * 工具自己拒绝执行时的理由（空 = 没有被工具拒绝）。
   *
   * 这一栏是**工具**的结论，不是门禁的：门禁放行了这次调用（它不知道
   * 命令是什么），工具拒绝了它（命令是 DANGEROUS，而调用方没带确认）。
   * 所以 allowed=false 有两种来路，这一栏说的是哪一种。
   */
  11: optional string refused,
  /**
   * 这是不是一次**演练**（dry_run）：什么都没跑，但那是调用方要的。
   *
   * 演练不是「被拦下」—— 把演练记成拒绝，就是在留痕唯一要回答的那个
   * 问题上造假警报。
   */
  12: optional bool dry_run,
  /** 演练的话，确认之后会不会真的执行。 */
  13: optional bool would_execute,
  /**
   * 这次调用的**活**有没有干砸（true = 干砸了）。
   *
   * ⚠️ 这一栏说的是「**工具的活没干成**」，不是「这次调用有错误」：
   * `error` 那一栏两种错误都装（门禁拒的、工具失败的），而**门禁拒掉
   * 一次调用不是坏了** —— 那是门禁在干活，两种情况下都**什么都没跑**。
   *
   * 只有「工具答了错」才算失败，而那种情况下命令**可能已经送到机器上了**
   * —— 这正是要跟「被拦下」分开记的理由。
   */
  14: optional bool failed,
  /**
   * 这次动作**有没有真的送到机器上**。
   *
   *   not_sent    根本没离开这个进程（重试是安全的）
   *   maybe_sent  可能已经在机器上跑了（**永不重放**）
   *
   * ⚠️ 缺这一格 = **没人说**，不是「肯定没送到」。
   */
  15: optional string delivery,
}

/** 门禁的一段判定。 */
struct AuditStage {
  /** 这一段是什么。 */
  1: required string stage,
  /** 这一段放行了吗。 */
  2: required bool allow,
  /** 为什么。 */
  3: optional string reason,
}

/**
 * 门禁留痕的查询结果（jmsx_audit_query）。
 *
 * entries 是**最新的在前** —— 「刚刚发生了什么」要的是最近的行，不是最老的。
 */
struct AuditQueryResult {
  /** 留痕文件在哪。 */
  1: required string trail_dir,
  /** 读到的行，最新的在前。 */
  2: optional list<AuditEntry> entries,
  /** 返回了几行。 */
  3: optional i32 count,
  /**
   * 一共匹配了几行（截断前的真实数字）。
   *
   * ⚠️ 它数的是「**匹配且读到**」的行：读不到的那些（太长、写坏了）在
   * skipped 里，不在这 一格 里 —— 把两格加起来才是「匹配到的总数」。
   */
  4: optional i32 total,
  /** 匹配的行比返回的多不多（true = 有截断）。 */
  5: optional bool truncated,
  /** 一句话说明这次答复是什么。 */
  6: optional string note,
  /**
   * 有几行读不了（跳过了）：太长，或者写坏了。
   *
   * ⚠️ 它在契约里，而不只是在 note 的一句中文里：agent 要知道「有几行没看到」
   * 不该靠解析一句话。
   *
   * ⚠️ 它数的是「**可能与你要的有关的**」那些读不了的行：别的工具的行读不出来，
   * 不算进你要的这一格 —— 否则 agent 会以为「有一条我关心的拒绝记录读不出来」，
   * 于是去重跑一遍。这一格非零 = **可能有**你要的东西没看到。
   *
   * ⚠️ 一个**正在写**的最后一行不算（它没写完，不是坏了）；但进程被杀掉留下的
   * 半个字尾行，安静超过五分钟后就算进来。
   */
  7: optional i32 skipped,
}
